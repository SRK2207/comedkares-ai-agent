# ==============================================================================
# ComedKares - Environment Configuration Example
# Copy to .env and fill with real local/sandbox values. NEVER commit .env.
# ==============================================================================

# --- Application ---
APP_ENV=development
APP_NAME=comedkares-ai-agent
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=INFO

# --- Local PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=comedkares
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_local_password
DATABASE_URL=postgresql+asyncpg://postgres:change_me_local_password@localhost:5432/comedkares
DATABASE_SYNC_URL=postgresql://postgres:change_me_local_password@localhost:5432/comedkares

# --- Security & OTP ---
JWT_SECRET_KEY=replace_with_32_plus_char_random_secret
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Use 'console' for local hackathon dev or 'twilio' / 'msg91' for SMS delivery
OTP_DELIVERY_PROVIDER=console

# --- Slot Hold & Waitlist ---
DEFAULT_HOLD_TTL_SECONDS=300
WAITLIST_OFFER_TTL_SECONDS=600

# --- LLM Provider (Tool Calling) ---
# Supported options: gemini | openai
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# --- Voice APIs (STT + TTS for English, Hindi, Kannada) ---
# Supported options: sarvam | google_cloud | openai | deepgram
STT_PROVIDER=sarvam
TTS_PROVIDER=sarvam
SARVAM_API_KEY=your_sarvam_api_key
GOOGLE_CLOUD_STT_CREDENTIALS_JSON=
GOOGLE_CLOUD_TTS_CREDENTIALS_JSON=
ELEVENLABS_API_KEY=

# --- Razorpay (Sandbox / Test Mode) ---
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# --- Clinic Integrations ---
# Google Calendar Adapter
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback
GOOGLE_SERVICE_ACCOUNT_FILE=

# Mock Clinic REST API Adapter
MOCK_CLINIC_API_BASE_URL=http://localhost:8001
MOCK_CLINIC_API_KEY=mock_clinic_dev_key

# --- Frontend Public Variables ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
